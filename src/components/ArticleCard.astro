---
interface Props {
  title: string
  description: string
  slug: string
  category: string
  pubDate: Date
  heroImage?: string
  featured?: boolean
}

const { title, description, slug, category, pubDate, heroImage, featured } = Astro.props

const NICHE_LABELS: Record<string, string> = {
  hip_hop_production: 'Hip Hop',
  pro_audio:          'Pro Audio',
  neo_soul:           'Neo Soul',
  home_studio:        'Home Studio',
  dj_gear:            'DJ Gear',
  vinyl_collecting:   'Vinyl',
  music_software:     'Software',
  music_theory:       'Theory',
}

const label = NICHE_LABELS[category] ?? category
const dateStr = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
---

<a href={`/articles/${slug}`} class="ct-card group flex flex-col">
  {heroImage && (
    <div class="aspect-video overflow-hidden">
      <img
        src={heroImage}
        alt={title}
        class="w-full h-full object-cover opacity-70 group-hover:opacity-85 transition-opacity"
        loading="lazy"
      />
    </div>
  )}
  <div class="p-5 flex flex-col gap-3 flex-1">
    <div class="flex items-center justify-between">
      <span class="ct-badge">{label}</span>
      <span class="text-xs text-muted">{dateStr}</span>
    </div>
    <h3 class="font-bold text-cream text-base leading-snug group-hover:text-cream/80 transition-colors line-clamp-2">
      {title}
    </h3>
    <p class="text-muted text-sm leading-relaxed line-clamp-2 flex-1">{description}</p>
    <span class="text-xs text-muted/60 group-hover:text-cream/50 transition-colors mt-auto">
      Read more &rsaquo;
    </span>
  </div>
</a>
