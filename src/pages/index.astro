---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import ArticleCard from '../components/ArticleCard.astro'
import DownloadCard from '../components/DownloadCard.astro'
import downloads from '../data/downloads.json'

const allArticles = await getCollection('articles')
const recent = allArticles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6)

const featuredDownloads = downloads.filter(d => d.featured).slice(0, 3)

const NICHES = [
  { slug: 'hip_hop_production', label: 'Hip Hop Production' },
  { slug: 'pro_audio',          label: 'Pro Audio'          },
  { slug: 'neo_soul',           label: 'Neo Soul'           },
  { slug: 'home_studio',        label: 'Home Studio'        },
  { slug: 'dj_gear',            label: 'DJ Gear'            },
  { slug: 'vinyl_collecting',   label: 'Vinyl'              },
  { slug: 'music_software',     label: 'Music Software'     },
  { slug: 'music_theory',       label: 'Music Theory'       },
]
---

<BaseLayout title="Crate Theory" description="Gear reviews, production guides, and free downloads for hip hop producers, audio engineers, and neo soul heads.">

  <!-- Hero -->
  <section class="relative border-b border-border overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style="background-image: url('/images/heroes/hero-home.jpg')"
    ></div>
    <div class="absolute inset-0 bg-gradient-to-r from-bg via-bg/80 to-transparent"></div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-24 sm:py-36">
      <div class="max-w-2xl">
        <p class="text-muted text-sm uppercase tracking-widest mb-4">Hip Hop &bull; Pro Audio &bull; Neo Soul</p>
        <h1 class="text-5xl sm:text-6xl font-black text-cream tracking-tight leading-none mb-6">
          Dig<br/>Deeper.
        </h1>
        <p class="text-muted text-lg leading-relaxed mb-8 max-w-lg">
          Gear reviews, production guides, free sample packs, and deep cuts for producers and audio heads who take the craft seriously.
        </p>
        <div class="flex items-center gap-3 flex-wrap">
          <a href="/blog" class="ct-btn-primary">Browse Articles</a>
          <a href="/downloads" class="ct-btn">Free Downloads</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Niche pills -->
  <section class="border-b border-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-5">
      <div class="flex items-center gap-2 flex-wrap">
        {NICHES.map(n => (
          <a href={`/${n.slug}`} class="ct-badge hover:border-cream/40 hover:text-cream/80 transition-colors cursor-pointer">
            {n.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Recent articles -->
  {recent.length > 0 && (
    <section class="border-b border-border">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-14">
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-xl font-black text-cream uppercase tracking-tight">Latest</h2>
          <a href="/blog" class="text-sm text-muted hover:text-cream transition-colors">All articles &rsaquo;</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {recent.map(article => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              slug={article.slug}
              category={article.data.category}
              pubDate={article.data.pubDate}
              heroImage={article.data.heroImage}
              featured={article.data.featured}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Featured downloads -->
  <section class="border-b border-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-14">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-xl font-black text-cream uppercase tracking-tight">Free Downloads</h2>
          <p class="text-muted text-sm mt-1">Sample packs, MIDI kits, and presets — no email required.</p>
        </div>
        <a href="/downloads" class="text-sm text-muted hover:text-cream transition-colors">All downloads &rsaquo;</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {featuredDownloads.map(d => (
          <DownloadCard
            title={d.title}
            description={d.description}
            category={d.category}
            tags={d.tags}
            price={d.price}
            downloadUrl={d.downloadUrl}
            featured={d.featured}
            fileInfo={d.fileInfo}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Store CTA -->
  <section>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-14">
      <div class="border border-border rounded-lg p-8 sm:p-12 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div>
          <h2 class="text-xl font-black text-cream uppercase tracking-tight mb-2">Crate Theory Merch</h2>
          <p class="text-muted text-sm max-w-md">Gear for the culture. Tees, hoodies, and accessories for producers and audio heads.</p>
        </div>
        <a href="/store" class="ct-btn-primary shrink-0">Shop Now</a>
      </div>
    </div>
  </section>

</BaseLayout>
