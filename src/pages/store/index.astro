---
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout title="Store" description="Crate Theory merch — tees, hoodies, and accessories for producers and audio heads.">

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">

    <div class="mb-10">
      <h1 class="text-3xl font-black text-cream uppercase tracking-tight mb-2">Crate Theory Merch</h1>
      <p class="text-muted text-base">Gear for the culture. Tees, hoodies, and accessories for producers and audio heads.</p>
    </div>

    <!--
      PRINTIFY POPUP STORE EMBED
      Replace the placeholder below with your Printify popup store embed code.
      In Printify: My stores → your store → Popup store → Get embed code
      Paste the <script> tag here.
    -->
    <div id="printify-store-embed" class="min-h-[600px] flex items-center justify-center border border-dashed border-border rounded-lg">
      <div class="text-center">
        <p class="text-muted text-sm mb-2">Printify popup store embed goes here.</p>
        <p class="text-muted/50 text-xs">Update <code class="font-mono">src/pages/store/index.astro</code> with your embed code from Printify.</p>
      </div>
    </div>

  </div>

</BaseLayout>
