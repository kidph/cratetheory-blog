---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ArticleCard from '../../components/ArticleCard.astro'

const allArticles = await getCollection('articles')
const sorted = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const NICHES = [
  { slug: 'hip_hop_production', label: 'Hip Hop Production' },
  { slug: 'pro_audio',          label: 'Pro Audio'          },
  { slug: 'neo_soul',           label: 'Neo Soul'           },
  { slug: 'home_studio',        label: 'Home Studio'        },
  { slug: 'dj_gear',            label: 'DJ Gear'            },
  { slug: 'vinyl_collecting',   label: 'Vinyl'              },
  { slug: 'music_software',     label: 'Music Software'     },
  { slug: 'music_theory',       label: 'Music Theory'       },
]
---

<BaseLayout title="Blog" description="Gear reviews, production guides, and deep cuts for hip hop producers, audio engineers, and neo soul heads.">

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">

    <div class="mb-10">
      <h1 class="text-3xl font-black text-cream uppercase tracking-tight mb-4">All Articles</h1>
      <div class="flex items-center gap-2 flex-wrap">
        <a href="/blog" class="ct-badge border-cream/40 text-cream/80">All</a>
        {NICHES.map(n => (
          <a href={`/${n.slug}`} class="ct-badge hover:border-cream/40 hover:text-cream/80 transition-colors">
            {n.label}
          </a>
        ))}
      </div>
    </div>

    {sorted.length === 0 ? (
      <div class="text-center py-24">
        <p class="text-muted text-lg">No articles yet. Check back soon.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {sorted.map(article => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            slug={article.slug}
            category={article.data.category}
            pubDate={article.data.pubDate}
            heroImage={article.data.heroImage}
            featured={article.data.featured}
          />
        ))}
      </div>
    )}

  </div>

</BaseLayout>
